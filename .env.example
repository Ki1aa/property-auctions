POSTGRES_USER=gis_user
POSTGRES_PASSWORD=gis_password
POSTGRES_DB=gis_torgi
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=sqlite+pysqlite:///../data/app.db

INGEST_PROVIDER=torgi_opendata
TORGI_OPENDATA_REGISTRY_URL=https://torgi.gov.ru/new/opendata/list.json
TORGI_OPENDATA_DATASET_ID=7710568760-notice
TORGI_OPENDATA_CARD_URL=https://torgi.gov.ru/new/public/opendata/61f2a3bf11d8ab36f6c1b275
# Manual override (fallback-2): direct data/structure URLs.
INGEST_SOURCE_URL=
INGEST_STRUCTURE_URL=
# Modes: operational (default) or backfill.
INGEST_MODE=operational
BACKFILL_FROM=
BACKFILL_TO=
INGEST_DAILY_OFFSET_DAYS=-1
SUPPORTED_STRUCTURE_VERSIONS=20240401
INGEST_INTERVAL_MINUTES=1440
INGEST_TIMEOUT_SECONDS=30
INGEST_RETRY_COUNT=3

# Region ingest scope.
# Comma-separated subjectEstateCode list. Empty = no region filter, ingest all Russia.
# 72 = Тюменская область, 86 = ХМАО, 89 = ЯНАО.
TARGET_REGION_CODES=
# Fallback comma-separated keywords for ИЖС detection when PermittedUse.code is absent.
IZHS_KEYWORDS=ИЖС,индивидуальное жилищное строительство,для индивидуального жилого
# Fetch notice detail JSON to extract cadastral fields.
INGEST_FETCH_NOTICE_DETAILS=true
# Per-run cap on detail fetches to protect against runaway HTTP load.
INGEST_DETAIL_MAX_PER_RUN=200
# MVP scope: keep land plots / land-right lots only; filters out vehicles, timber, premises, etc.
INGEST_ONLY_LAND_LOTS=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Master switch: false disables all Telegram sends (tokens can stay in .env).
TELEGRAM_ALERTS_ENABLED=true
# If true, send Telegram alerts only for lots flagged as ИЖС candidate.
TELEGRAM_ALERT_ONLY_IZHS=false
# If true, skip Telegram when cadastral_number is missing.
TELEGRAM_ALERT_REQUIRE_CADASTRAL=false
# If true, skip Telegram alerts with no practical signal: not IZHS, no cadastral, no area-based price/baseline.
TELEGRAM_ALERT_SKIP_LOW_SIGNAL=true
# Minimum discount_to_baseline (0..1), e.g. 0.1 = 10% below internal baseline. Omit to disable threshold.
# Lots without baseline still pass unless TELEGRAM_ALERT_REQUIRE_BASELINE_FOR_DISCOUNT=true.
TELEGRAM_ALERT_MIN_DISCOUNT_TO_BASELINE=
# If true and TELEGRAM_ALERT_MIN_DISCOUNT_TO_BASELINE is set, skip lots without baseline discount.
TELEGRAM_ALERT_REQUIRE_BASELINE_FOR_DISCOUNT=false
# Hide preview for the first link in alert messages (recommended for long URLs).
TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=true
# Max characters per message (Telegram hard limit 4096).
TELEGRAM_MAX_MESSAGE_LENGTH=4096
# Retries when Telegram returns HTTP 429.
TELEGRAM_SEND_MAX_RETRIES=2
# Optional HTTP(S) proxy for Bot API when api.telegram.org is unreachable from the host.
TELEGRAM_PROXY_URL=
# Telegram Bot API request timeout in seconds.
TELEGRAM_TIMEOUT_SECONDS=20

# Public base URL of the SPA (no trailing slash), for /api/lots link fields and Telegram «Монитор».
APP_PUBLIC_BASE_URL=
# If true, API and Telegram include best-effort Domclick/Avito/Cian search URLs.
# These may open captcha or empty search pages, so MVP keeps them off by default.
INCLUDE_MARKETPLACE_SEARCH_URLS=false
# If true, API/Telegram include map links around known lot centroids (NSPD/lat-lon).
INCLUDE_MARKETPLACE_MAP_URLS=true
MARKETPLACE_MAP_RADIUS_KM=5
# Optional overrides for marketplace search URLs; {q} is URL-encoded query text.
DOMCLICK_SEARCH_TEMPLATE=https://domclick.ru/search?query={q}
AVITO_LAND_SEARCH_TEMPLATE=https://www.avito.ru/all/zemelnye_uchastki?q={q}
CIAN_LAND_SEARCH_TEMPLATE=https://www.cian.ru/kupit-uchastok/?text={q}

# NSPD (nspd.gov.ru) geoportal search — requires RU network route; ingest calls when NSPD_ENABLED=true.
NSPD_ENABLED=false
NSPD_BASE_URL=https://nspd.gov.ru
NSPD_GEOPORTAL_SEARCH_PATH=/api/geoportal/v1/search/geoportal
NSPD_GEOPORTAL_THEMATIC_ID=1
NSPD_TIMEOUT_SECONDS=30
# Keep true in production. Set false only if local split tunneling returns a broken/self-signed TLS chain.
NSPD_VERIFY_TLS=true
NSPD_MAX_PER_RUN=100
NSPD_REFRESH_AFTER_DAYS=14
# notice_only | nspd_when_notice_missing | prefer_nspd — whether to copy NSPD area/address into Lot fields.
NSPD_MERGE_AREA_POLICY=notice_only
NSPD_MERGE_ADDRESS_POLICY=notice_only

# First-time dev: set true to run one ingest when ingest_runs is empty on startup. Use false in production.
RUN_INGEST_ON_STARTUP=true

FRONTEND_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
