POSTGRES_USER=gis_user
POSTGRES_PASSWORD=gis_password
POSTGRES_DB=gis_torgi
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=sqlite+pysqlite:///../data/app.db

INGEST_PROVIDER=torgi_opendata
TORGI_OPENDATA_REGISTRY_URL=https://torgi.gov.ru/new/opendata/list.json
TORGI_OPENDATA_DATASET_ID=7710568760-notice
TORGI_OPENDATA_CARD_URL=https://torgi.gov.ru/new/public/opendata/61f2a3bf11d8ab36f6c1b275
# Manual override (fallback-2): direct data/structure URLs.
INGEST_SOURCE_URL=
INGEST_STRUCTURE_URL=
# Modes: operational (default) or backfill.
INGEST_MODE=operational
BACKFILL_FROM=
BACKFILL_TO=
INGEST_DAILY_OFFSET_DAYS=-1
SUPPORTED_STRUCTURE_VERSIONS=20240401
INGEST_INTERVAL_MINUTES=1440
INGEST_TIMEOUT_SECONDS=30
INGEST_RETRY_COUNT=3

# Land plot focus.
# Comma-separated subjectRightHolderCode list. Empty = no region filter.
# 72 = Тюменская область, 86 = ХМАО, 89 = ЯНАО.
TARGET_REGION_CODES=
# Comma-separated keywords for ИЖС detection (case-insensitive substring match).
IZHS_KEYWORDS=ИЖС,индивидуальное жилищное строительство,для индивидуального жилого,2.1
# Fetch notice detail JSON to extract cadastral fields.
INGEST_FETCH_NOTICE_DETAILS=true
# Per-run cap on detail fetches to protect against runaway HTTP load.
INGEST_DETAIL_MAX_PER_RUN=200

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# If true, send Telegram alerts only for lots flagged as ИЖС candidate.
TELEGRAM_ALERT_ONLY_IZHS=false

# First-time dev: set true to run one ingest when ingest_runs is empty on startup. Use false in production.
RUN_INGEST_ON_STARTUP=true

FRONTEND_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
