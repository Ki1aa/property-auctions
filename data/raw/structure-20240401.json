{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "OpenDataList",
  "description": "Структура набора открытых данных извещений и информационных сообщений. Версия 3.1 от 01.04.2024",
  "type": "object",
  "properties": {
    "listObjects": {
      "$ref": "#/definitions/ListObjects"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ListObjects": {
      "description": "Cхема для списка выгруженных открытых данных",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ListObject"
      }
    },
    "ListObject": {
      "description": "Информация о выгруженном объекте данных",
      "type": "object",
      "properties": {
        "bidderOrgCode": {
          "description": "Код организации организатора торгов",
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "rightHolderCode": {
          "description": "Код организации правообладателя",
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "documentType": {
          "description": "Тип документа:\r\nnoticeCancel - Отмена извещения;\r\nnoticeStop - Уведомление о приостановке процедуры;\r\nnoticeResumption - Уведомление о возобновление;\r\nclarifications - Разъяснение;\r\nnotice - Извещение;\r\nnoticeAnnulment - Информация о аннулировании результатов торгов.",
          "type": "string",
          "enum": [
            "noticeCancel",
            "noticeStop",
            "noticeResumption",
            "clarifications",
            "notice",
            "noticeAnnulment"
          ]
        },
        "regNum": {
          "description": "Реестровый номер объекта",
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "publishDate": {
          "description": "Дата публикации на сайте torgi.gov.ru ",
          "type": "string",
          "format": "date-time"
        },
        "biddTypeCode": {
          "description": "Вид торгов",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "ownershipFormsCode": {
          "description": "Форма собственности",
          "type": "string",
          "minLength": 2,
          "maxLength": 11
        },
        "subjectEstateCode": {
          "description": "Субъект местонахождения имущества",
          "type": "string",
          "minLength": 1,
          "maxLength": 3
        },
        "subjectRightHolderCode": {
          "description": "Субъект местонахождения правообладателя",
          "type": "string",
          "minLength": 1,
          "maxLength": 3
        },
        "href": {
          "description": "Гиперссылка на скачивание структурированного документа",
          "type": "string"
        }
      },
      "required": [
        "bidderOrgCode",
        "rightHolderCode",
        "documentType",
        "regNum",
        "publishDate",
        "href"
      ]
    }
  }
}